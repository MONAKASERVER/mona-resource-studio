{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mona Resource Studio",
  "version": "0.1.9",
  "identifier": "net.monacraft.resource-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Mona Resource Studio", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640, "resizable": true, "center": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https:; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "createUpdaterArtifacts": true },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDQzlGNzA3N0ZENTM1RTQKUldUa05kVi9CL2ZKYktCaWRwU1UwbHl5ZUFKYWRIYWsyT25QNWlUV3NLWFhCTC9FZWduTFFoc2QK",
      "endpoints": ["https://github.com/MONAKASERVER/mona-resource-studio/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
